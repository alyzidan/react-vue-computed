{
  "name": "react-vue-computed",
  "version": "1.0.0",
  "description": "Vue's computed mental model brought to React via Proxy and useSyncExternalStore",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
